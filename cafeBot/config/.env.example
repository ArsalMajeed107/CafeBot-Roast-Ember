# CafeBot Environment Configuration Example
# Copy to .env and populate values when integrating a backend and AI service.
# Never commit .env or real API keys to Git.

PORT=3000
NODE_ENV=development

# Future AI Model Configuration (not connected in Phase 1)
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini

# Data Paths
MENU_DATA_PATH=./data/menu.json
ORDERS_DATA_PATH=./data/orders.json
